{
  "ignoreCommand": "bash scripts/vercel_ignore.sh",
  "git": { "deploymentEnabled": {
    "team/backend-quant/**": false, "team/quant/**": false, "team/platform/**": false, "team/data/**": false,
    "team/agents-ai/**": false, "team/qa-ops/**": false, "team/test-eng/**": false
  } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": { "api/summary.ts": { "maxDuration": 30 }, "api/check-ticker.ts": { "maxDuration": 20 }, "api/logo-domain.ts": { "maxDuration": 10 }, "api/marks.ts": { "maxDuration": 10 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" }
  ] }, { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}

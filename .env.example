# Copy to .env on the server (encrypted with sops+age). NEVER commit real keys. Paper keys only.
# --- Execution + market data + news (free Alpaca paper account) ---
ALPACA_API_KEY=
ALPACA_SECRET=            # ALPACA_API_SECRET is also accepted
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# --- Free data keys ---
FINNHUB_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
MASSIVE_API_KEY=          # ex-Polygon free tier: nightly grouped daily bars
DATABENTO_API_KEY=        # one-time historical credit; validation only (scripts/fetch_databento.py), NEVER in the live path
# SEC EDGAR needs no key, only an identifying User-Agent with a contact email
SEC_USER_AGENT="Kaibot research your-email@example.com"
# --- AI ---
ANTHROPIC_API_KEY=
# LLM caps (#309, config/llm.yaml): $1/day, $20/month alert, $25/month hard, $150 in all.
# Agent room (M3): off unless set to on AND the key above is filled. Stays off in Stage 1. See docs/ops/agent_room.md.
KAIBOT_ROOM=off
# Shadow pre-open review (#310): "shadow" = an observer that records verdicts on the day's buys, never acts on them.
# Needs only the key above (not KAIBOT_ROOM). Unset or anything else: off.
KAIBOT_PREOPEN=
# Daily report in plain words (#311): "on" = one paragraph after the close, written by Haiku from the
# engine's own records (about $0.0005/day). Without the key above: a template paragraph. Unset: off.
KAIBOT_DAILY_NOTE=
# --- Storage + auth (Supabase free) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # engine only (SUPABASE_SERVICE_ROLE_KEY also accepted); never in Vercel
# --- Ops ---
HEALTHCHECKS_PING_URL=

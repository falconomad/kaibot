# Copy to .env on the server (encrypted with sops+age). NEVER commit real keys. Paper keys only.
# --- Execution + market data + news (free Alpaca paper account) ---
ALPACA_API_KEY=
ALPACA_SECRET=            # ALPACA_API_SECRET is also accepted
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# --- Free data keys ---
FINNHUB_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
MASSIVE_API_KEY=          # ex-Polygon free tier: nightly grouped daily bars
DATABENTO_API_KEY=        # one-time historical credit; validation only (scripts/fetch_databento.py), NEVER in the live path
# SEC EDGAR needs no key, only an identifying User-Agent with a contact email
SEC_USER_AGENT="Kaibot research your-email@example.com"
# --- AI ---
ANTHROPIC_API_KEY=
# Agent room (M3): off unless set to on AND the key above is filled. Capped at $3/day (then rules-only),
# $190/month (then no new entries). See docs/ops/agent_room.md.
KAIBOT_ROOM=off
# --- Storage + auth (Supabase free) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # engine only (SUPABASE_SERVICE_ROLE_KEY also accepted); never in Vercel
# --- Ops ---
HEALTHCHECKS_PING_URL=
